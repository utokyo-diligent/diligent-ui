---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  label: string;
  description?: string;
  eyebrow?: string;
}

const { class: className, label, description, eyebrow, target, rel, ...attributes } = Astro.props;
---

<a
  {...attributes}
  class:list={['link-row', className]}
  data-slot="link-row"
  target={target}
  rel={target === '_blank' ? `noopener noreferrer ${rel ?? ''}`.trim() : rel}
>
  <span class="link-row-copy">
    {eyebrow && <span class="link-row-eyebrow">{eyebrow}</span>}
    <span class="link-row-label">{label}</span>
    {description && <span class="link-row-description">{description}</span>}
  </span>
  <svg class="link-row-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
    <path d="M4 12h15m-6-6 6 6-6 6" />
  </svg>
</a>

<style>
  .link-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: var(--link-row-padding, 1.25rem 0);
    border-block-start: 1px solid var(--border);
    color: var(--foreground);
    text-decoration: none;
  }

  .link-row:focus-visible {
    outline: 2px solid var(--outline);
    outline-offset: 3px;
  }

  .link-row-copy {
    display: grid;
    gap: 0.375rem;
    overflow-wrap: anywhere;
  }

  .link-row-label {
    font-size: var(--link-row-label-size, var(--text-content-title-size));
    font-weight: var(--text-content-title-weight);
    line-height: var(--text-content-title-leading);
  }

  .link-row:hover .link-row-label,
  .link-row:focus-visible .link-row-label {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .link-row-eyebrow,
  .link-row-description {
    color: var(--muted-foreground);
  }

  .link-row-eyebrow {
    font-size: var(--text-caption-size);
    line-height: var(--text-caption-leading);
  }

  .link-row-description {
    font-size: var(--text-note-size);
    line-height: var(--text-note-leading);
  }

  .link-row-arrow {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--link-row-arrow-color, var(--primary));
  }

  .link-row-arrow:dir(rtl) { transform: scaleX(-1); }
</style>
