---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  newTabLabel?: string;
}

const { class: className, target, rel, newTabLabel, ...attributes } = Astro.props;
const opensNewTab = target === '_blank';
---
<a class:list={['text-link', className]} data-slot="text-link" target={target} rel={opensNewTab ? `noopener noreferrer ${rel ?? ''}`.trim() : rel} {...attributes}>
  <slot name="start" />
  <slot />
  <slot name="end" />
  {opensNewTab && newTabLabel && <span class="sr-only">{newTabLabel}</span>}
</a>
<style>
  .text-link { display: inline-flex; align-items: center; gap: 18px; color: var(--text-link-color, inherit); font-size: var(--text-link-size, var(--text-note-size)); font-weight: var(--text-link-weight, var(--text-action-weight)); }
  .text-link:hover { text-decoration: underline; }
  .text-link :global(svg) { width: 19px; height: 19px; flex-shrink: 0; }
</style>
