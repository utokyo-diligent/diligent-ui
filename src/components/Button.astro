---
import ButtonPrimitive from "@starwind-ui/astro/button";
import type { HTMLAttributes } from "astro/types";
import type { VariantProps } from "tailwind-variants";
import { button } from "./button-variants";

interface Props
  extends HTMLAttributes<"button">, Omit<HTMLAttributes<"a">, "type">, VariantProps<typeof button> {
  as?: "button" | "a";
  "data-slot"?: string;
  "data-disabled"?: string;
  focusableWhenDisabled?: boolean;
}

const {
  variant,
  size,
  as: buttonAs,
  href,
  disabled = false,
  focusableWhenDisabled,
  "data-slot": dataSlot = "button",
  tabindex,
  class: className,
  role,
  "aria-disabled": ariaDisabled,
  "data-disabled": dataDisabled,
  ...attributes
} = Astro.props;

const classes = button({ variant, size, class: className });
---

{
  buttonAs === "a" || href !== undefined ? (
    <a
      class={classes}
      href={disabled ? undefined : href}
      {...attributes}
      role={disabled ? "link" : role}
      aria-disabled={disabled ? "true" : ariaDisabled}
      data-disabled={disabled ? "" : dataDisabled}
      tabindex={disabled ? (focusableWhenDisabled ? 0 : -1) : tabindex}
      data-slot={dataSlot}
    >
      <slot />
    </a>
  ) : (
    <ButtonPrimitive.Root
      class={classes}
      disabled={disabled}
      focusableWhenDisabled={focusableWhenDisabled}
      {...attributes}
      role={role}
      {...(!disabled && { "aria-disabled": ariaDisabled, "data-disabled": dataDisabled })}
      tabindex={tabindex}
      data-slot={dataSlot}
    >
      <slot />
    </ButtonPrimitive.Root>
  )
}
