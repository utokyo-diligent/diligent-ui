---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import ImageCarouselControls from './ImageCarouselControls.astro';
import { responsiveImage } from '../lib/responsive-image';

interface CarouselLabels {
  carousel: string;
  slide: string;
  play: string;
  pause: string;
  select: string;
  showPhoto: (number: number) => string;
}

const defaultLabels: CarouselLabels = {
  carousel: 'カルーセル',
  slide: 'スライド',
  play: 'スライドを再生',
  pause: 'スライドを一時停止',
  select: '写真を選択',
  showPhoto: (number) => `写真${number}を表示`,
};

interface Props extends HTMLAttributes<'div'> {
  slides: readonly { image: ImageMetadata; alt: string; brightness?: number }[];
  label: string;
  labels?: CarouselLabels;
  autoplay?: boolean;
  sizes?: string;
}

const { slides, label, labels = defaultLabels, autoplay = true, sizes = '100vw', ...attributes } = Astro.props;
if (!slides.length) throw new Error('ImageCarousel requires at least one slide.');
---
<diligent-image-carousel
  data-image-carousel
  data-autoplay={autoplay}
  data-slot="image-carousel"
  role="region"
  aria-roledescription={labels.carousel}
  aria-label={label}
  {...attributes}
>
  <div class="carousel-viewport" data-viewport>
    {slides.map((slide, index) => (
      <div
        data-slide
        data-active={String(index === 0)}
        role="group"
        aria-roledescription={labels.slide}
        aria-label={`${index + 1} / ${slides.length}`}
        aria-hidden={index === 0 ? undefined : 'true'}
        hidden={index !== 0}
      >
        <Image
          src={slide.image}
          alt={slide.alt}
          {...responsiveImage(slide.image, 2400, [640, 1024, 1600])}
          sizes={sizes}
          quality={85}
          loading="eager"
          fetchpriority={index === 0 ? 'high' : 'low'}
          draggable="false"
          class="carousel-image"
          style={`--slide-brightness: ${slide.brightness ?? 1}`}
        />
      </div>
    ))}
  </div>
  {slides.length > 1 && <ImageCarouselControls slideCount={slides.length} labels={labels} />}
</diligent-image-carousel>

<script>
  import { setupImageCarousel } from '../behaviors/image-carousel';

  class DiligentImageCarousel extends HTMLElement {
    #dispose?: () => void;

    connectedCallback() {
      this.#dispose = setupImageCarousel(this);
    }

    disconnectedCallback() {
      this.#dispose?.();
    }
  }

  if (!customElements.get('diligent-image-carousel')) {
    customElements.define('diligent-image-carousel', DiligentImageCarousel);
  }
</script>

<style>
  diligent-image-carousel { display: block; }

  .carousel-viewport {
    display: grid;
    overflow: hidden;
    background: var(--image-carousel-background, var(--background));
    touch-action: pan-y pinch-zoom;
    user-select: none;
  }

  [data-slide][hidden] { display: none; }
  [data-slide] { grid-area: 1 / 1; opacity: 0; transition: opacity 600ms ease; }
  [data-slide][data-active='true'] { opacity: 1; z-index: 1; }

  .carousel-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: brightness(var(--slide-brightness, 1));
  }

  @media (prefers-reduced-motion: reduce) {
    [data-slide] { transition: none; }
  }

  @media (max-width: 767px) {
    .carousel-image { aspect-ratio: 4 / 3; }
  }
</style>
