---
import { Button, LinkRow, PageHeading, SectionHeading, ContentSection, FactList, PhotoGallery, ImageCarousel, CtaPanel, TextMediaSection, EditorialHero, CardRail } from '../../../src';
import '../../../styles.css';
import light from '../assets/sample.svg';
import dark from '../assets/sample-dark.svg';
import TokenReference from '../components/TokenReference.astro';

const slides = [
  { image: light, alt: '明るい背景の抽象的な山のイラスト' },
  { image: dark, alt: '暗い背景の抽象的な山のイラスト' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Diligent UI — component examples</title>
  </head>
  <body>
    <main>
      <PageHeading>UI Components</PageHeading>
      <TokenReference />
      <ContentSection id="buttons" title="Button">
        <div class="button-examples">
          <Button data-example="default-button">標準</Button>
          <Button variant="outline">アウトライン</Button>
          <Button variant="ghost">プレーン</Button>
          <Button disabled>無効</Button>
          <Button href="#content" data-example="link">リンク</Button>
          <Button href="#content" disabled aria-disabled="false" data-example="disabled-link">無効なリンク</Button>
          <Button href="#content" disabled focusableWhenDisabled data-example="focusable-disabled-link">フォーカス可能な無効リンク</Button>
          <Button tabindex={-1} data-example="tabindex-button">tabindex −1</Button>
          <Button size="icon" aria-label="追加" title="追加"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9 2h2v16H9zM2 9h16v2H2z" fill="currentColor" /></svg></Button>
        </div>
      </ContentSection>
      <section aria-labelledby="section-heading">
        <SectionHeading id="section-heading" title="SectionHeading"><a href="#content">アクション →</a></SectionHeading>
      </section>
      <ContentSection id="links" title="LinkRow">
        <LinkRow href="#content" label="コンポーネント概要" eyebrow="01 / ガイド" description="本文の構成を確認できます。" data-example="link-row" />
        <LinkRow href="#facts" label="情報一覧" />
      </ContentSection>
      <ContentSection id="content" title="ContentSection">
        <p>見出しと本文を縦に並べます。本文の構成はスロットで指定します。</p>
      </ContentSection>
      <ContentSection id="facts" title="FactList">
        <FactList items={[{ label: '表示形式', value: 'HTML・CSSを中心に構成' }, { label: '長い値', value: 'https://example.com/a-very-long-value-that-must-wrap-inside-the-available-width-without-overflowing' }]} />
      </ContentSection>
      <ContentSection id="carousel" title="ImageCarousel">
        <ImageCarousel slides={slides} label="自動再生のサンプル" sizes="(max-width: 767px) calc(100vw - 40px), 100vw" />
      </ContentSection>
      <ContentSection id="single-slide" title="ImageCarousel: 1枚・自動再生なし">
        <ImageCarousel slides={[slides[0]]} label="1枚のサンプル" autoplay={false} />
      </ContentSection>
      <ContentSection id="gallery" title="PhotoGallery">
        <PhotoGallery photos={slides.map((slide, index) => ({ ...slide, caption: `写真 ${index + 1}` }))} />
      </ContentSection>
      <ContentSection id="single-photo" title="PhotoGallery: 1枚">
        <PhotoGallery photos={[{ ...slides[0], caption: '1枚の場合は全幅で表示します。' }]} sizes="100vw" />
      </ContentSection>
      <ContentSection id="typography" title="Typography helpers">
        <h3 class="section-title">セクションの見出し</h3>
        <h4 class="content-title">本文内の見出し</h4>
        <p class="text-note">補足には既存の注記トークンを適用します。</p>
      </ContentSection>
      <TextMediaSection id="text-media" aria-labelledby="text-media-heading" data-example="text-media">
        <h2 class="section-title" id="text-media-heading">テキストと画像</h2>
        <p>本文と画像を2列に並べ、狭い画面では縦に表示します。</p>
        <img slot="media" src={light.src} alt="抽象的な山のイラスト" width="1280" height="800" />
      </TextMediaSection>
      <TextMediaSection id="media-first" mediaFirst aria-labelledby="media-first-heading" data-example="media-first">
        <h2 class="section-title" id="media-first-heading">画像から始まる紹介</h2>
        <p>画像を先に配置し、同じ読み順で表示します。</p>
        <img slot="media" src={dark.src} alt="暗い背景の山のイラスト" width="1280" height="800" />
      </TextMediaSection>
      <EditorialHero id="editorial-example" title="ページの導入部" sectionTitle="紹介" description={['複数の段落を指定できます。', '文言・画像・リンクは利用側が渡します。']} data-example="editorial-hero">
        <img slot="media" src={light.src} alt="導入部の山のイラスト" width="1280" height="800" />
        <Button slot="actions" href="#content">概要を見る</Button>
      </EditorialHero>
      <section aria-labelledby="card-rail-heading">
        <h2 class="section-title" id="card-rail-heading">横スクロールのカード</h2>
        <CardRail label="サンプルカード一覧" data-example="card-rail">
          {Array.from({ length: 8 }, (_, index) => (
            <li class="sample-card">
              <img src={light.src} alt="" width="1280" height="800" />
              <h3 class="content-title">サンプル {index + 1}</h3>
              <p class="text-note">カードの内容は利用側が指定します。</p>
            </li>
          ))}
        </CardRail>
      </section>
      <CtaPanel id="cta-example" title="詳しく知りたい方へ" href="#content" label="概要を確認する" data-example="cta-panel">
        <p class="text-note">補足の説明もスロットで追加できます。</p>
      </CtaPanel>
    </main>
  </body>
</html>
<style>
  body { margin: 0; font-family: var(--font-body); }
  main { width: min(100% - 112px, 1328px); margin-inline: auto; padding-bottom: 80px; }
  p { line-height: 2; }
  .button-examples { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  #text-media, #media-first, #editorial-example, section:has(> #card-rail-heading) { margin-bottom: 72px; }
  .sample-card { background: var(--surface-subtle); padding-bottom: 16px; }
  .sample-card h3, .sample-card p { padding-inline: 12px; }
  @media (max-width: 767px) { main { width: calc(100% - 40px); } }
</style>
