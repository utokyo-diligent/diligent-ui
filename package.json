{
  "name": "@utokyo-diligent/ui",
  "version": "0.1.0",
  "description": "Reusable Astro components and design tokens for Tailwind CSS v4.",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "type": "module",
  "files": [
    "src/index.ts",
    "src/behaviors/*.ts",
    "src/button/*.astro",
    "src/button/*.ts",
    "src/components/*.astro",
    "src/styles/*.css",
    "styles.css",
    "starwind.config.json"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styles.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./behaviors/image-carousel": "./src/behaviors/image-carousel.ts"
  },
  "sideEffects": ["**/*.css", "**/*.astro"],
  "scripts": {
    "dev": "astro dev --port 4322",
    "check": "astro check",
    "build": "astro build",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": { "astro": "^7.4.5" },
  "dependencies": {
    "@starwind-ui/astro": "1.4.0",
    "@tailwindcss/forms": "^0.5.11",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "astro": "^7.4.5",
    "typescript": "^6.0.3"
  }
}
